{
  "upstream": "https://github.com/PowerJob/PowerJob",
  "upstream_branch": "master",
  "upstream_commit": "d92ad66277ca54e14e2835b2e5a6aaf01f620684",
  "upstream_version": "5.1.7",
  "repository": "powerjob-server",
  "kind": "service",
  "modules": [
    "powerjob-server"
  ],
  "retained_paths": [
    "LICENSE",
    "README.md",
    "README_zhCN.md",
    "SECURITY.md",
    ".gitignore",
    "others/images/",
    "others/",
    "docker-compose.yml",
    "powerjob-server/"
  ],
  "historical_paths": [
    "README_enUS.md",
    "oh-my-scheduler-server/"
  ],
  "dependencies": {
    "powerjob-common": {
      "artifacts": [
        "tech.powerjob:powerjob (parent POM)",
        "tech.powerjob:powerjob-common",
        "tech.powerjob:powerjob-remote-framework",
        "tech.powerjob:powerjob-remote-impl-akka",
        "tech.powerjob:powerjob-remote-impl-http",
        "tech.powerjob:powerjob-remote-impl-mu"
      ],
      "default_path": "../powerjob-common"
    },
    "powerjob-client": {
      "artifacts": [
        "tech.powerjob:powerjob-client"
      ],
      "default_path": "../powerjob-client"
    }
  },
  "excluded_tests": [
    {
      "module": "powerjob-server/powerjob-server-starter",
      "test": "tech.powerjob.server.test.RepositoryTest",
      "reason": "Needs MySQL at localhost:3306 (the test profile datasource); the Spring context cannot start without it."
    },
    {
      "module": "powerjob-server/powerjob-server-starter",
      "test": "tech.powerjob.server.test.ServiceTest",
      "reason": "Needs MySQL at localhost:3306 (the test profile datasource); the Spring context cannot start without it."
    },
    {
      "module": "powerjob-server/powerjob-server-starter",
      "test": "tech.powerjob.server.test.ServerInfoServiceTest",
      "reason": "Needs MySQL at localhost:3306 (the test profile datasource); the Spring context cannot start without it."
    },
    {
      "module": "powerjob-server/powerjob-server-starter",
      "test": "tech.powerjob.server.test.QueryConvertUtilsTest",
      "reason": "Needs MySQL at localhost:3306 (the test profile datasource); the Spring context cannot start without it."
    }
  ],
  "test_jvm_options": [
    {
      "module": "powerjob-server/powerjob-server-starter",
      "value": "-Duser.timezone=Asia/Shanghai",
      "reason": "Scheduler tests assert wall-clock times in the timezone upstream develops in."
    }
  ],
  "test_isolation": [
    {
      "module": "powerjob-server/powerjob-server-starter",
      "setting": "reuseForks=false",
      "reason": "Upstream's TimezoneTest changes the JVM default timezone, which breaks later tests in a shared JVM."
    }
  ],
  "verified_java": 8,
  "build_command": "mvn -B clean verify",
  "filter_tool": "git-filter-repo a40bce548d2c"
}
